# ==============================================================================
# Atlas-Quant Environment Configuration
# Strict $0 Budget & Multi-Key Runtime Routing
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Project & Operating Mode
# ------------------------------------------------------------------------------
PROJECT_NAME="Atlas-Quant"
ENVIRONMENT="development"  # development | paper_soak | production
OUTPUT_MODE="BUILD"

# ------------------------------------------------------------------------------
# 2. Broker & Trading Mode (Hard Constraints)
# ------------------------------------------------------------------------------
# Paper trading is default. Live trading requires explicit database approval signature.
PAPER_TRADING=true
LIVE_TRADING=false
HUMAN_APPROVAL_REQUIRED=true

# MetaTrader 5 (Windows-native 64-bit terminal)
MT5_PATH="C:\\Program Files\\MetaTrader 5\\terminal64.exe"
MT5_LOGIN=12345678
MT5_PASSWORD="demo_password_here"
MT5_SERVER="MetaQuotes-Demo"
MT5_TIMEOUT_MS=60000
BROKER_HEARTBEAT_INTERVAL_SEC=15

# ------------------------------------------------------------------------------
# 3. Dual Gemini API Routing ($0 Net Spend Guarantee)
# ------------------------------------------------------------------------------
# Project A: Free tier (no billing enabled). Used for routine tasks:
# Observe, regime tagging, news parsing, logging, agent heartbeat.
GEMINI_FREE_API_KEY="AIzaSy_FREE_KEY_PROJECT_A_HERE"

# Project B: Google AI Pro Monthly Cloud Credit ($0 hard budget cap).
# Used strictly for: Diagnose, Hypothesize, Keep-or-Revert.
GEMINI_DEEP_API_KEY="AIzaSy_DEEP_KEY_PROJECT_B_HERE"

# Models
GEMINI_ROUTINE_MODEL="gemini-3.8-flash"
GEMINI_DEEP_MODEL="gemini-4-argon"

# Deep LLM Guardrails
DEEP_LLM_CALLS_PER_DAY=20
MAX_DEEP_PROMPT_TOKENS=8192
ENABLE_LLM_RESPONSE_CACHE=true
BUDGET_CAP_USD=0.00
ALERT_BUDGET_THRESHOLD_USD=1.00

# ------------------------------------------------------------------------------
# 4. Database & Cache
# ------------------------------------------------------------------------------
DATABASE_URL="sqlite:///./data/atlas_quant.db"
REDIS_URL="redis://localhost:6379/0"  # Optional, fallback to in-memory bus

# ------------------------------------------------------------------------------
# 5. Risk Engine Hard Limits (Immutable by AI Self-Improvement Loop)
# ------------------------------------------------------------------------------
RISK_MAX_DAILY_LOSS_PCT=0.03       # 3% daily equity circuit breaker (PAUSED)
RISK_MAX_DRAWDOWN_PCT=0.10         # 10% peak-to-trough circuit breaker (HALTED)
RISK_PER_TRADE_FRACTION=0.01       # 1% equity risk per trade
RISK_MAX_OPEN_POSITIONS=3
RISK_MAX_DAILY_TRADES=10
RISK_MAX_SPREAD_PIPS=2.5
RISK_NEWS_BLACKOUT_MINUTES=30
RISK_ALLOWED_SESSIONS="LONDON,NEW_YORK,OVERLAP_LDN_NY"

# ------------------------------------------------------------------------------
# 6. Notifications & Alerts
# ------------------------------------------------------------------------------
ALERT_TELEGRAM_BOT_TOKEN=""
ALERT_TELEGRAM_CHAT_ID=""
ALERT_SLACK_WEBHOOK_URL=""
ALERT_CONSOLE_LOG=true

# ------------------------------------------------------------------------------
# 7. Admin Security Tokens & API Protection
# Generate secure tokens using: python scripts/gen_secrets.py
# ------------------------------------------------------------------------------
ADMIN_API_KEY=""                                        # Secret API Key to protect /admin/* and /orders endpoints (filled by scripts/gen_secrets.py)
ADMIN_EMERGENCY_KILL_TOKEN=""                           # Secret token required for /admin/kill (filled by scripts/gen_secrets.py)
ADMIN_RESET_TOKEN=""                                    # Secret token required for /admin/reset-circuit-breaker (filled by scripts/gen_secrets.py)
ADMIN_HMAC_SECRET=""                                    # HMAC secret key for verifying human approval signatures (filled by scripts/gen_secrets.py)
ORDER_RATE_LIMIT_MAX=10                                 # Max orders per window per API key
ORDER_RATE_LIMIT_WINDOW_SEC=60                          # Sliding window size in seconds

# ------------------------------------------------------------------------------
# 8. Safety & Disclaimer
# ------------------------------------------------------------------------------
RISK_DISCLAIMER="Research/educational only. Not financial advice. Past performance does not guarantee future results. Live trading requires explicit human approval."

